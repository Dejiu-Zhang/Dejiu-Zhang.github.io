<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Yueshan Zhang — PhD student in Biostatistics at UC Berkeley. Causal inference & AI for public health." />
  <title>Yueshan Zhang</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
</head>
<body>
<div id="cur-dot" class="cur-dot"></div>
<div id="cur-ring" class="cur-ring"></div>

<!-- ══════════════ NAVBAR ══════════════ -->
<nav id="navbar">
  <div class="nav-inner">
    <a href="#about" class="nav-logo">Yueshan</a>
    <div class="nav-links">
      <a href="#about"     class="nav-link active" data-target="about">About</a>
      <a href="#research"  class="nav-link"         data-target="research">Research</a>
      <a href="#resources" class="nav-link"         data-target="resources">Resources</a>
      <a href="#contact"   class="nav-link"         data-target="contact">Contact</a>
      <button id="themeToggle" class="theme-toggle" aria-label="Toggle theme">
        <span class="tt-track"><span class="tt-knob"></span></span>
        <span class="tt-icon">
          <svg class="tt-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor"/>
          </svg>
          <svg class="tt-sun" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" fill="currentColor"/>
            <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
    </div>
  </div>
</nav>

<!-- ══════════════ DOT NAV ══════════════ -->
<div class="dot-nav" id="dotNav">
  <button class="dot active" data-section="about"     aria-label="About"><span class="dot-label">About</span></button>
  <button class="dot"        data-section="research"  aria-label="Research"><span class="dot-label">Research</span></button>
  <button class="dot"        data-section="resources" aria-label="Resources"><span class="dot-label">Resources</span></button>
  <button class="dot"        data-section="contact"   aria-label="Contact"><span class="dot-label">Contact</span></button>
</div>

<!-- ══════════════ SCROLL CONTAINER ══════════════ -->
<div id="scroll-container">

  <!-- ░░░░ SECTION 1 · ABOUT ░░░░ -->
  <section id="about" class="section s-about">
    <canvas id="particles-canvas"></canvas>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="about-layout">
      <div class="about-left">
        <div class="greeting r-item">
          <span class="bounce-dots">
            <span class="bd"></span>
            <span class="bd"></span>
            <span class="bd"></span>
          </span>
        </div>
        <h1 class="hero-name r-item">
          <span class="name-line">Yueshan <span class="name-accent">Zhang</span></span>
        </h1>
        <div class="hero-role r-item">
          <span class="role-pre">PhD Student · </span><span id="typewriter" class="role-dyn"></span><span class="cursor">|</span>
        </div>
        <p class="hero-bio r-item">
          My Chinese name is 张越珊. Friends call me "Dejiu" (得九) because 3×3=9, and the nickname stuck.
          I earned my B.S. from the School of Mathematical Sciences at <strong>Nankai University</strong>,
          and in Spring 2025 I was a visiting student at <strong>UC Berkeley</strong> for summer research.
          This fall, I will join UC Berkeley as a PhD student in Biostatistics, and I'm honored to be advised by
          <a href="https://sites.google.com/berkeley.edu/jingshenwang/" target="_blank" rel="noopener" class="bio-link">Prof. Jingshen Wang</a>.
        </p>
        <p class="hero-bio r-item">
          My research interests include <strong>causal inference</strong> and <strong>AI for public health</strong>.
          I'm also genuinely excited about new and modern AI tools.
        </p>
        <div class="hero-tags r-item">
          <span class="tag">Causal Inference</span>
          <span class="tag">AI · Public Health</span>
          <span class="tag">Biostatistics</span>
        </div>
        <div class="hero-cta r-item">
          <a href="#research"  class="btn btn-p">View Research</a>
          <a href="/cv.pdf" target="_blank" rel="noopener" class="btn btn-o">Download CV</a>
          <a href="#contact"   class="btn btn-g">Get in Touch</a>
        </div>
      </div>

      <div class="about-right r-item">
        <div class="avatar-scene" id="avatarScene">
          <div class="avatar-ring" id="avatarRing">
            <div class="blob-glow" id="blobGlow"></div>
            <div class="blob-border" id="blobBorder">
              <div class="blob-accent"></div>
              <div class="blob-inner">
                <div class="avatar-circle">
                  <img class="avatar-photo" src="/avatar.png" alt="Yueshan Zhang" />
                </div>
              </div>
            </div>
          </div>
          <div class="side-dots">
            <span class="dot dot-gold"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
          <img src="/Chiikawa1.png" class="chiikawa ck1" alt="" />
          <img src="/Chiikawa2.png" class="chiikawa ck2" alt="" />
          <img src="/Chiikawa3.png" class="chiikawa ck3" alt="" />
        </div>
      </div>
    </div>

    <div class="scroll-hint">
      <div class="mouse"><div class="wheel"></div></div>
      <span>Scroll to explore</span>
    </div>
  </section>

  <!-- ░░░░ SECTION 2 · RESEARCH ░░░░ -->
  <section id="research" class="section s-research">
    <div class="bg-num">02</div>
    <div class="orb orb-r1"></div>
    <div class="orb orb-r2"></div>

    <div class="sec-header">
      <div class="sec-label"><span class="sec-bar"></span><span>Research Work</span></div>
      <h2 class="sec-title rr">Research</h2>
      <p class="sec-sub rr">Working at the intersection of statistics, causal inference, and public health</p>
    </div>

    <div class="research-grid">
      <div class="rcard tilt rr" style="--d:0s">
        <div class="card-glow"></div>
        <div class="card-inner">
          <div class="card-top">
            <div class="card-meta"><span class="cyear">2026</span><span class="cstatus st-acc">Accepted</span></div>
            <span class="ctype">Journal Article</span>
          </div>
          <h3 class="ctitle"><a href="https://www.sciencedirect.com/science/article/abs/pii/S0965856426001072" target="_blank" rel="noopener" class="ctitle-link">Congestion Pricing in New York City: Effects on Ride-Hailing and Transit ↗</a></h3>
          <p class="cdesc">Estimated causal impacts of NYC's $1.50 per-trip congestion charge on Uber, Lyft, and subway ridership using two-way fixed effects with high-frequency panel data. Leveraged Lyft's temporary rider credit as a quasi-experiment.</p>
          <div class="ctags"><span>Causal Inference</span><span>Transportation</span><span>Panel Data</span></div>
          <div class="cfoot">
            <span class="cjournal">Transportation Research Part A</span>
            <span class="cadv">Adv: <a href="https://sites.google.com/view/manxi-wu/home" target="_blank" rel="noopener">Prof. Manxi Wu</a></span>
          </div>
        </div>
      </div>

      <div class="rcard tilt rr" style="--d:0.12s">
        <div class="card-glow"></div>
        <div class="card-inner">
          <div class="card-top">
            <div class="card-meta"><span class="cyear">2026</span><span class="cstatus st-prep">Under Review</span></div>
            <span class="ctype">Manuscript</span>
          </div>
          <h3 class="ctitle"><a href="https://www.researchgate.net/publication/400858210" target="_blank" rel="noopener" class="ctitle-link">Where Do Adolescent Digital Twins Succeed and Fail? ↗</a></h3>
          <p class="cdesc">Survey-anchored adolescent "digital twins" built from 2023 YRBS with narrative memory via RAG. Multi-layer validation and in-silico replications of 10 published adolescent RCTs. <a href="https://aidigitalyouth.onrender.com" target="_blank" rel="noopener" class="cdesc-link">Live demo ↗</a></p>
          <div class="ctags"><span>LLM Agents</span><span>Public Health</span><span>RAG</span></div>
          <div class="cfoot">
            <span class="cjournal">Nature Human Behaviour</span>
            <span class="cadv">Adv: <a href="https://sites.google.com/berkeley.edu/jingshenwang/" target="_blank" rel="noopener">Prof. Jingshen Wang</a></span>
          </div>
        </div>
      </div>

      <div class="rcard nova-card tilt rr" style="--d:0.24s">
        <div class="nova-bg-mesh"></div>
        <div class="card-inner nova-inner">
          <div class="card-top">
            <div class="card-meta">
              <span class="cstatus nb-live">● Live</span>
              <span class="cstatus nb-vibe">Vibe Coding</span>
            </div>
            <span class="ctype">Side Project</span>
          </div>
          <span class="nova-wordmark">Nova</span>
          <p class="nova-tagline">AI Research Guidance Platform</p>
          <p class="cdesc">An AI research mentor that turns <em>"I have data but no idea what to study"</em> into a complete, publishable project — for high schoolers and undergrads who can't access traditional mentorship. Answer a few questions, get a tailored research plan, and run all analysis directly in the browser. <strong>No setup, no server, no professor required.</strong></p>
          <div class="ctags nova-stack"><span>Next.js</span><span>Claude Code</span><span>Pyodide</span><span>RAG</span></div>
          <a href="https://open-research-ruby.vercel.app/" target="_blank" rel="noopener" class="nova-cta">
            <span class="nova-cta-text">Visit Platform</span>
            <span class="nova-cta-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░░░ SECTION 3 · RESOURCES ░░░░ -->
  <section id="resources" class="section s-resources">
    <div class="bg-num">03</div>
    <div class="orb orb-g1"></div>

    <div class="sec-header">
      <div class="sec-label"><span class="sec-bar sec-bar-g"></span><span>Study Materials</span></div>
      <h2 class="sec-title rv">Resources</h2>
      <p class="sec-sub rv">Notes &amp; mind maps from undergraduate studies at Nankai University</p>
    </div>

    <div class="res-body rv">
      <div class="res-scroll">
        <div class="courses-grid">
          {undergradCourses.map((course, ci) => (
            <div class="ccard" data-ci={ci}>
              <button class="ccard-head" type="button">
                <span class="ccard-name">{course.name} <em class="ccard-en">{course.en}</em></span>
                <span class="ccard-count">{course.items.length}</span>
                <span class="ccard-arrow">▾</span>
              </button>
              <div class="ccard-body">
                <div class="ccard-items">
                  {course.items.map((item) => (
                    <div class="citem">
                      <span class="citem-title">{item.title}</span>
                      <span class="citem-links">
                        {(('pdfs' in item ? item.pdfs : []) as {label:string,url:string}[]).map((p) => (
                          <a href={enc(p.url)} target="_blank" rel="noopener" class="clink pdf">{p.label}</a>
                        ))}
                        {item.xmind && (
                          <a href={enc(item.xmind)} download class="clink xmind">XMind</a>
                        )}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ░░░░ SECTION 4 · CONTACT ░░░░ -->
  <section id="contact" class="section s-contact">
    <div class="bg-num">04</div>
    <div class="orb orb-p1"></div>
    <div class="orb orb-p2"></div>

    <div class="contact-layout">
      <div class="contact-left">
        <div class="sec-label cv"><span class="sec-bar sec-bar-p"></span><span>Get In Touch</span></div>
        <h2 class="contact-head cv">
          Let's<br/><span class="ch-accent">Connect</span>
