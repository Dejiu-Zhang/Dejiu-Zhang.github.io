<style is:global>
/* ═══════════════════════════════════
   RESET
═══════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
a { text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }
img { display: block; max-width: 100%; }

/* ═══════════════════════════════════
   DARK THEME (default)
═══════════════════════════════════ */
html {
  --bg:       #0a0a0c;
  --surf:     #111114;
  --surf2:    #181818;
  --card-bg:  rgba(20,20,26,0.7);
  --nav-bg:   rgba(10,10,12,0.82);
  --border:   rgba(255,255,255,0.07);
  --accent:   #e8c872;
  --accent-l: #f0d896;
  --accent2:  #72c5e8;
  --coral:    #e87272;
  --green:    #72e8b0;
  --yellow:   #e8c872;
  --text:     #ede9df;
  --muted:    #a09d94;
  --subtle:   #6b6860;
  --bg-num-c: rgba(255,255,255,0.025);
  --hover-bg: rgba(255,255,255,0.025);
  --nav-h: 60px;
  --sans:  'Space Grotesk', sans-serif;
  --serif: 'Playfair Display', serif;
  --mono:  'JetBrains Mono', monospace;
}

/* ═══════════════════════════════════
   LIGHT THEME
═══════════════════════════════════ */
html[data-theme="light"] {
  --bg:       #f5f0e8;
  --surf:     #ebe5d9;
  --surf2:    #dfd9cc;
  --card-bg:  rgba(255,255,255,0.65);
  --nav-bg:   rgba(245,240,232,0.88);
  --border:   rgba(0,0,0,0.08);
  --accent:   #b8943e;
  --accent-l: #c8a450;
  --accent2:  #3a8aab;
  --coral:    #c45454;
  --green:    #3aab6e;
  --yellow:   #b8943e;
  --text:     #1a1816;
  --muted:    #6b665c;
  --subtle:   #9a9590;
  --bg-num-c: rgba(0,0,0,0.04);
  --hover-bg: rgba(0,0,0,0.025);
}

html, body { height: 100%; overflow: hidden; background: var(--bg); }
body {
  font-family: var(--sans); color: var(--text);
  -webkit-font-smoothing: antialiased;
  transition: background 0.5s, color 0.5s;
}

/* smooth theme transitions */
*, *::before, *::after {
  transition-property: background-color, border-color, color, box-shadow;
  transition-duration: 0s;
}
body.t-switching, body.t-switching *, body.t-switching *::before, body.t-switching *::after {
  transition-duration: 0.45s !important;
}

/* ═══════════════════════════════════
   NAVBAR
═══════════════════════════════════ */
#navbar {
  position: fixed; top: 0; left: 0; right: 0;
  height: var(--nav-h); z-index: 200;
  background: var(--nav-bg);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  max-width: 1300px; margin: 0 auto;
  height: 100%; display: flex; align-items: center; justify-content: space-between;
  padding: 0 2.5rem;
}
.nav-logo {
  font-family: var(--serif); font-style: italic;
  font-size: 1.4rem; color: var(--accent); transition: opacity 0.3s;
}
.nav-logo:hover { opacity: 0.8; }
.nav-links { display: flex; align-items: center; gap: 1.75rem; }
.nav-link {
  font-size: 0.83rem; font-weight: 600; letter-spacing: 0.06em;
  color: var(--muted); position: relative; transition: color 0.3s; padding-bottom: 2px;
}
.nav-link::after {
  content: ''; position: absolute; bottom: -2px; left: 0;
  width: 0; height: 2px; background: var(--accent); transition: width 0.3s;
}
.nav-link:hover, .nav-link.active { color: var(--text); }
.nav-link:hover::after, .nav-link.active::after { width: 100%; }

/* Theme toggle */
.theme-toggle {
  display: flex; align-items: center; gap: 0.45rem;
  padding: 0.3rem 0.6rem; border-radius: 100px;
  background: var(--surf); border: 1px solid var(--border);
  cursor: pointer; transition: border-color 0.3s;
}
.theme-toggle:hover { border-color: var(--accent); }
.tt-track {
  width: 30px; height: 16px; border-radius: 8px;
  background: var(--surf2); border: 1px solid var(--border);
  position: relative; transition: background 0.4s;
}
html[data-theme="light"] .tt-track { background: var(--accent); }
.tt-knob {
  position: absolute; top: 1.5px; left: 1.5px;
  width: 11px; height: 11px; border-radius: 50%;
  background: var(--subtle); transition: transform 0.4s cubic-bezier(0.4,0,0.2,1), background 0.4s;
}
html[data-theme="light"] .tt-knob { transform: translateX(14px); background: white; }
.tt-icon { display: flex; align-items: center; }
.tt-moon { color: var(--muted); display: block; }
.tt-sun  { color: var(--accent); display: none; }
html[data-theme="light"] .tt-moon { display: none; }
html[data-theme="light"] .tt-sun  { display: block; }

/* ═══════════════════════════════════
   DOT NAV
═══════════════════════════════════ */
.dot-nav {
  position: fixed; right: 1.75rem; top: 50%;
  transform: translateY(-50%); z-index: 200;
  display: flex; flex-direction: column; gap: 1.1rem;
}
.dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--subtle); cursor: pointer; position: relative;
  transition: all 0.35s ease;
}
.dot:hover, .dot.active {
  background: var(--accent);
  box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 60%, transparent);
  transform: scale(1.5);
}
.dot-label {
  position: absolute; right: 1.6rem; top: 50%;
  transform: translateY(-50%) translateX(6px);
  opacity: 0; transition: all 0.3s;
  font-size: 0.72rem; color: var(--muted); white-space: nowrap;
  background: var(--surf2); padding: 0.2rem 0.6rem;
  border-radius: 5px; border: 1px solid var(--border);
  pointer-events: none;
}
.dot:hover .dot-label { opacity: 1; transform: translateY(-50%) translateX(0); }

/* ═══════════════════════════════════
   SCROLL CONTAINER & SECTIONS
═══════════════════════════════════ */
#scroll-container {
  height: 100vh; overflow-y: scroll;
  scroll-snap-type: y mandatory; scroll-behavior: smooth;
}
#scroll-container::-webkit-scrollbar { display: none; }
.section {
  height: 100vh; scroll-snap-align: start;
  position: relative; overflow: hidden;
  display: flex; flex-direction: column;
  background: var(--bg);
}

/* ═══════════════════════════════════
   SHARED DECORATIVE
═══════════════════════════════════ */
.orb {
  position: absolute; border-radius: 50%;
  pointer-events: none; filter: blur(80px); opacity: 0.14;
}
html[data-theme="light"] .orb { opacity: 0.07; filter: blur(90px) saturate(0.35); }

.bg-num {
  position: absolute; right: 3rem; bottom: -1rem;
  font-size: clamp(6rem,18vw,14rem); font-family: var(--serif);
  font-weight: 700; color: var(--bg-num-c);
  line-height: 1; pointer-events: none; user-select: none; z-index: 0;
}
.sec-label { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem; }
.sec-bar { width: 36px; height: 2px; background: var(--accent); border-radius: 2px; }
.sec-bar-g { background: var(--green); }
.sec-bar-p { background: var(--coral); }
.sec-label span:last-child {
  font-family: var(--mono); font-size: 0.72rem;
  color: var(--accent); letter-spacing: 0.18em; text-transform: uppercase;
}
.sec-title {
  font-family: var(--serif); font-size: clamp(2.2rem,5vw,3.8rem);
  font-weight: 700; line-height: 1.1; margin-bottom: 0.4rem;
}
.sec-sub { color: var(--muted); font-size: 0.95rem; white-space: nowrap; }

.r-item, .rr, .rv, .cv {
  opacity: 0; transform: translateY(32px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.r-item.on, .rr.on, .rv.on, .cv.on { opacity: 1; transform: translateY(0); }

/* ═══════════════════════════════════
   S1 — ABOUT
═══════════════════════════════════ */
.orb-1 { width:550px; height:550px; background:var(--accent); top:-150px; right:-100px; animation: od 12s ease-in-out infinite; }
.orb-2 { width:350px; height:350px; background:var(--accent2); bottom:-80px; left:-60px; animation: od 9s ease-in-out infinite 2s; }
.orb-3 { width:200px; height:200px; background:var(--coral); top:30%; left:40%; animation: od 7s ease-in-out infinite 4s; }
@keyframes od { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(20px,-20px) scale(1.08)} }

#particles-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }

.about-layout {
  display: flex; align-items: center; justify-content: space-between;
  gap: 3rem; padding: 0 5rem 0 9rem;
  height: 100%; max-width: 1400px; margin: 0 auto; width: 100%;
  padding-top: var(--nav-h); position: relative; z-index: 1;
}
.about-left { flex: 1; max-width: 680px; display: flex; flex-direction: column; gap: 1.1rem; position: relative; top: -2vh; }
.about-right { flex: 0 0 auto; margin-right: 5rem; }

.greeting { display: flex; align-items: center; }

.bounce-dots { display: flex; align-items: center; gap: 7px; }
.bd {
  display: inline-block; width: 9px; height: 9px; border-radius: 50%;
  animation: bd-jump 1.5s ease-in-out infinite;
}
.bd:nth-child(1) { background: var(--accent);  animation-delay: 0s; }
.bd:nth-child(2) { background: var(--coral);   animation-delay: 0.2s; }
.bd:nth-child(3) { background: var(--accent2); animation-delay: 0.4s; }
@keyframes bd-jump {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-11px); }
}

.hero-name {
  font-family: var(--serif); font-size: clamp(3rem,6vw,5.5rem);
  line-height: 1.05; font-weight: 700;
}
.name-line { display: block; color: var(--text); }
.name-accent { color: var(--accent); font-style: italic; }

.hero-role {
  font-family: var(--mono); font-size: 1rem; color: var(--muted);
  display: flex; align-items: center; gap: 0.2rem; flex-wrap: wrap;
}
.role-dyn { color: var(--accent2); }
.cursor { color: var(--accent); animation: blink 1s step-end infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

.hero-bio { color: var(--muted); line-height: 1.8; font-size: 0.95rem; }
.hero-bio strong { color: var(--text); font-weight: 600; }
.bio-link {
  color: var(--accent2);
  text-decoration: underline;
  text-decoration-color: color-mix(in srgb, var(--accent2) 35%, transparent);
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
  transition: text-decoration-color 0.3s, color 0.3s;
}
.bio-link:hover {
  color: var(--accent-l);
  text-decoration-color: var(--accent-l);
}

.hero-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tag {
  padding: 0.3rem 0.8rem; border: 1px solid var(--border);
  border-radius: 100px; font-size: 0.78rem; color: var(--muted);
  background: var(--surf); font-family: var(--mono); transition: all 0.3s;
}
.tag:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); color: var(--accent); }

.hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.btn {
  padding: 0.7rem 1.6rem; border-radius: 8px;
  font-size: 0.88rem; font-weight: 600; transition: all 0.3s;
  display: inline-flex; align-items: center;
}
.btn-p { background: var(--accent); color: #111; }
.btn-p:hover { background: var(--accent-l); transform: translateY(-2px); box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 35%, transparent); }
.btn-o { background: transparent; color: var(--accent2); border: 1px solid var(--accent2); }
.btn-o:hover { background: color-mix(in srgb, var(--accent2) 10%, transparent); transform: translateY(-2px); }
.btn-g { background: transparent; color: var(--muted); border: 1px solid var(--border); }
.btn-g:hover { color: var(--text); border-color: var(--muted); transform: translateY(-2px); }

/* ── Blob Avatar ── */
.avatar-scene {
  position: relative; width: 100%; max-width: 410px;
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  cursor: pointer;
}
.avatar-ring {
  position: relative; width: 86%; aspect-ratio: 1;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.12s ease-out; will-change: transform;
}
.blob-glow {
  position: absolute; inset: -10px;
  background: radial-gradient(circle, rgba(184,148,62,.15) 0%, transparent 65%);
  opacity: 0; transition: opacity 0.5s; pointer-events: none;
  animation: morph 8s ease-in-out infinite;
}
.avatar-scene:hover .blob-glow { opacity: 1; }
.blob-border {
  width: 100%; height: 100%; padding: 3px; position: relative;
  background: linear-gradient(135deg, #b8943e, #d4ae58, #c8a448, #b8943e);
  background-size: 200% 200%;
  animation: borderFlow 6s ease-in-out infinite, morph 8s ease-in-out infinite;
  transition: box-shadow 0.4s;
}
.avatar-scene:hover .blob-border { box-shadow: 0 0 28px rgba(184,148,62,.28); }
.blob-border.is-clicked { animation: clickPop 0.8s ease forwards !important; }
.blob-glow.is-clicked   { animation: clickPop 0.8s ease forwards !important; }
.blob-accent {
  position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(circle at 30% 30%, rgba(232,193,112,.15) 0%, transparent 50%),
    radial-gradient(circle at 70% 70%, rgba(91,184,169,.1) 0%, transparent 50%);
  opacity: 0.6;
}
.blob-inner {
  width: 100%; height: 100%; border-radius: inherit; overflow: hidden;
  background: var(--bg); display: grid; place-items: center;
  transition: background 0.5s;
}
.avatar-circle {
  width: 80%; height: 80%; border-radius: 50%; overflow: hidden;
  border: 2px solid rgba(184,148,62,.35);
  transition: transform 0.4s, filter 0.4s;
}
.avatar-scene:hover .avatar-circle { transform: scale(1.03); filter: brightness(1.03); }
.avatar-photo { width: 100%; height: 100%; object-fit: cover; display: block; }

/* dark-mode blob overrides */
[data-theme="dark"] .blob-border {
  background: linear-gradient(135deg, #c8956c, #e8c170, #d4a574, #e8c170, #c8956c);
  background-size: 300% 300%;
  animation: borderGlow 5s ease-in-out infinite, morph 8s ease-in-out infinite;
  box-shadow: 0 0 18px rgba(232,193,112,.12), 0 0 36px rgba(200,149,108,.06);
}
[data-theme="dark"] .avatar-scene:hover .blob-border {
  box-shadow: 0 0 30px rgba(232,193,112,.22), 0 0 60px rgba(200,149,108,.1);
}
[data-theme="dark"] .blob-glow {
  background: radial-gradient(circle, rgba(232,193,112,.14) 0%, transparent 65%);
  inset: -16px; opacity: 0.6;
}
[data-theme="dark"] .avatar-scene:hover .blob-glow { opacity: 1; }
[data-theme="dark"] .blob-accent {
  background:
    radial-gradient(circle at 35% 35%, rgba(232,193,112,.12) 0%, transparent 50%),
    radial-gradient(circle at 70% 70%, rgba(200,149,108,.08) 0%, transparent 50%);
}
[data-theme="dark"] .avatar-circle { border-color: rgba(232,193,112,.25); }
[data-theme="dark"] .dot-gold { background: #e8c170; }
[data-theme="dark"] .dot:not(.dot-gold) { background: #444; }

/* blob keyframes */
@keyframes morph {
  0%,100% { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; }
  25%      { border-radius: 50% 50% 60% 40% / 45% 55% 45% 55%; }
  50%      { border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%; }
  75%      { border-radius: 40% 60% 55% 45% / 55% 40% 60% 40%; }
}
@keyframes borderFlow {
  0%,100% { background-position: 0% 50%; }
  50%     { background-position: 100% 50%; }
}
@keyframes borderGlow {
  0%,100% { background-position: 0% 50%; }
  33%     { background-position: 100% 0%; }
  66%     { background-position: 50% 100%; }
}
@keyframes clickPop {
  0%   { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; transform: scale(1); }
  25%  { border-radius: 50%; transform: scale(0.95); }
  50%  { border-radius: 50%; transform: scale(1.04); }
  75%  { border-radius: 50%; transform: scale(0.99); }
  100% { border-radius: 50%; transform: scale(1); }
}

/* side dots */
.side-dots {
  position: absolute; right: -24px; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 10px;
}
.dot { width: 6px; height: 6px; border-radius: 50%; background: #999; opacity: 0.25; transition: all 0.4s; }
.dot-gold { background: #c8956c; opacity: 0.5; }
.avatar-scene:hover .dot-gold { opacity: 0.8; transform: translateX(-3px); }
.avatar-scene:hover .dot { opacity: 0.4; transform: translateX(-3px); }

/* Chiikawa stickers */
.chiikawa { position: absolute; z-index: 4; pointer-events: none; drop-shadow: 0 2px 8px rgba(0,0,0,0.3); }
.ck1 { width: 78px; top: 5%; left: 5%; animation: ckf 3.2s ease-in-out infinite; }
.ck2 { width: 64px; top: 12%; right: 4%; animation: ckf 3.7s ease-in-out infinite 0.6s; }
.ck3 { width: 70px; bottom: 8%; right: 8%; animation: ckf 4.1s ease-in-out infinite 1.3s; }
@keyframes ckf {
  0%,100% { transform: translateY(0) rotate(-4deg); }
  50% { transform: translateY(-14px) rotate(4deg); }
}


.scroll-hint {
  position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  z-index: 1; animation: sh 2.5s ease-in-out infinite;
}
@keyframes sh { 0%,100%{opacity:0.4;transform:translateX(-50%) translateY(0)} 50%{opacity:1;transform:translateX(-50%) translateY(6px)} }
.mouse { width: 22px; height: 34px; border: 2px solid color-mix(in srgb, var(--text) 20%, transparent); border-radius: 11px; display: flex; justify-content: center; padding-top: 5px; }
.wheel { width: 3px; height: 7px; background: var(--accent); border-radius: 2px; animation: sw 1.6s ease-in-out infinite; }
@keyframes sw { 0%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(8px)} }
.scroll-hint span { font-size: 0.65rem; color: var(--subtle); letter-spacing: 0.12em; text-transform: uppercase; font-family: var(--mono); }

/* ═══════════════════════════════════
   S2 — RESEARCH
═══════════════════════════════════ */
.s-research {
  padding: var(--nav-h) 5rem 2rem;
  display: flex; flex-direction: column; justify-content: center;
}
.orb-r1 { width:400px; height:400px; background:var(--accent); top:-100px; left:-80px; animation: od 14s ease-in-out infinite; }
.orb-r2 { width:300px; height:300px; background:var(--coral); bottom:-60px; right:-60px; animation: od 10s ease-in-out infinite 3s; }
.s-research .sec-header { margin-bottom: 1.5rem; position: relative; z-index: 1; }
.s-research .sec-label span:last-child { color: var(--accent); }

.research-grid {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 1.25rem; position: relative; z-index: 1;
  max-height: calc(100vh - var(--nav-h) - 160px);
}

.rcard {
  background: var(--card-bg); border: 1px solid var(--border);
  border-radius: 16px; position: relative; overflow: hidden;
  transition: border-color 0.35s, box-shadow 0.35s;
  transform-style: preserve-3d; will-change: transform;
  display: flex; flex-direction: column; backdrop-filter: blur(6px);
}
.rcard:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); box-shadow: 0 20px 50px color-mix(in srgb, var(--bg) 50%, transparent); }
.card-glow {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(circle at var(--mx,50%) var(--my,50%), color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 55%);
  opacity: 0; transition: opacity 0.35s;
}
.card-glow-y {
  background: radial-gradient(circle at var(--mx,50%) var(--my,50%), color-mix(in srgb, var(--accent) 14%, transparent) 0%, transparent 55%);
}
.rcard:hover .card-glow { opacity: 1; }
.card-inner { padding: 1.4rem; display: flex; flex-direction: column; flex: 1; position: relative; z-index: 1; }
.card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.85rem; }
.card-meta { display: flex; align-items: center; gap: 0.5rem; }
.cyear { font-family: var(--mono); font-size: 0.7rem; color: var(--subtle); }
.cstatus {
  font-size: 0.67rem; padding: 0.18rem 0.55rem; border-radius: 100px;
  font-weight: 700; font-family: var(--mono); letter-spacing: 0.05em;
}
.st-acc {
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  animation: pacc 2.5s ease-in-out infinite;
}
@keyframes pacc { 0%,100%{box-shadow:0 0 0 0 color-mix(in srgb, var(--accent) 25%, transparent)} 50%{box-shadow:0 0 0 5px transparent} }
.st-prep {
  background: color-mix(in srgb, var(--green) 12%, transparent);
  color: var(--green);
  border: 1px solid color-mix(in srgb, var(--green) 30%, transparent);
  animation: pg 2.5s ease-in-out infinite 0.8s;
}
@keyframes pg { 0%,100%{box-shadow:0 0 0 0 color-mix(in srgb, var(--green) 25%, transparent)} 50%{box-shadow:0 0 0 5px transparent} }
.st-proj {
  background: color-mix(in srgb, var(--accent2) 12%, transparent);
  color: var(--accent2);
  border: 1px solid color-mix(in srgb, var(--accent2) 28%, transparent);
}
.ctype { font-size: 0.68rem; color: var(--subtle); font-family: var(--mono); }
.ctitle { font-family: var(--serif); font-size: 1rem; font-weight: 600; line-height: 1.45; margin-bottom: 0.65rem; color: var(--text); }
.cdesc { font-size: 0.82rem; color: var(--muted); line-height: 1.7; flex: 1; margin-bottom: 0.85rem; }
.ctags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.85rem; }
.ctags span {
  font-size: 0.67rem; padding: 0.18rem 0.5rem; border-radius: 4px;
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  color: var(--accent-l); font-family: var(--mono);
}
.cfoot { border-top: 1px solid var(--border); padding-top: 0.7rem; display: flex; justify-content: space-between; align-items: center; }
.cjournal { font-size: 0.72rem; color: var(--subtle); font-style: italic; }
.ctitle-link {
  color: inherit;
  text-decoration: none;
  transition: color 0.25s;
}
.ctitle-link:hover { color: var(--accent); }
.cadv { font-size: 0.72rem; color: var(--subtle); }
.cadv a { color: var(--accent2); }
.cadv a:hover { text-decoration: underline; }
.cdesc-link { color: var(--accent2); font-family: var(--mono); font-size: 0.75em; border-bottom: 1px solid color-mix(in srgb, var(--accent2) 35%, transparent); transition: border-color 0.2s, color 0.2s; }
.cdesc-link:hover { color: var(--accent-l); border-color: var(--accent-l); }

.nb-live {
  background: color-mix(in srgb, var(--green) 12%, transparent);
  color: var(--green);
  border: 1px solid color-mix(in srgb, var(--green) 30%, transparent);
  animation: pg 2.5s ease-in-out infinite;
}
.nb-vibe {
  background: color-mix(in srgb, var(--coral) 10%, transparent);
  color: var(--coral); font-style: italic;
  border: 1px solid color-mix(in srgb, var(--coral) 25%, transparent);
}

/* ── Nova card special visuals ── */
.nova-card {
  border-color: color-mix(in srgb, var(--accent2) 30%, transparent) !important;
  animation: nova-pulse 4s ease-in-out infinite;
}
@keyframes nova-pulse {
  0%,100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent2) 0%, transparent); }
  50%      { box-shadow: 0 0 24px color-mix(in srgb, var(--accent2) 20%, transparent); }
}
.nova-card:hover {
  border-color: color-mix(in srgb, var(--accent2) 60%, transparent) !important;
  box-shadow: 0 0 36px color-mix(in srgb, var(--accent2) 22%, transparent), 0 20px 50px color-mix(in srgb, var(--bg) 50%, transparent) !important;
  transform: translateY(-3px);
  animation: none;
}
.nova-bg-mesh {
  position: absolute; inset: 0; pointer-events: none; opacity: 0.05;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 22px, var(--accent2) 22px, var(--accent2) 23px),
    repeating-linear-gradient(90deg, transparent, transparent 22px, var(--accent2) 22px, var(--accent2) 23px);
  transition: opacity 0.4s;
}
.nova-card:hover .nova-bg-mesh { opacity: 0.09; }
.nova-inner { gap: 0.7rem; }
.nova-wordmark {
  font-family: var(--serif); font-size: 1.9rem; font-weight: 700;
  line-height: 1; letter-spacing: -0.02em;
  background: linear-gradient(135deg, var(--accent2), color-mix(in srgb, var(--accent2) 55%, var(--accent)));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  display: block;
}
.nova-tagline { font-size: 0.75rem; color: var(--muted); font-weight: 500; margin-top: -0.2rem; }
.nova-inner .cdesc em { font-style: italic; color: var(--accent2); font-family: var(--serif); }
.nova-inner .cdesc strong { color: var(--text); font-weight: 600; }
.nova-stats {
  display: flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; flex-shrink: 0;
}
.nova-stat {
  flex: 1; padding: 0.5rem 0.3rem; text-align: center;
  display: flex; flex-direction: column; gap: 0.15rem;
  border-right: 1px solid var(--border);
  background: color-mix(in srgb, var(--accent2) 4%, transparent);
}
.nova-stat:last-child { border-right: none; }
.ns-val { font-family: var(--mono); font-size: 0.95rem; font-weight: 700; color: var(--accent2); }
.ns-lab { font-size: 0.55rem; color: var(--subtle); letter-spacing: 0.04em; text-transform: uppercase; }
.nova-stack span {
  background: color-mix(in srgb, var(--accent2) 10%, transparent) !important;
  color: var(--accent2) !important;
  border: 1px solid color-mix(in srgb, var(--accent2) 22%, transparent) !important;
}
.nova-cta {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.55rem 0.8rem; border-radius: 7px; margin-top: auto;
  background: color-mix(in srgb, var(--accent2) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent2) 28%, transparent);
  transition: background 0.3s, border-color 0.3s;
  text-decoration: none;
}
.nova-card:hover .nova-cta {
  background: color-mix(in srgb, var(--accent2) 18%, transparent);
  border-color: color-mix(in srgb, var(--accent2) 50%, transparent);
}
.nova-cta-text { font-size: 0.78rem; font-weight: 600; color: var(--accent2); font-family: var(--mono); }
.nova-cta-arrow { font-size: 0.9rem; color: var(--accent2); transition: transform 0.3s; }
.nova-card:hover .nova-cta-arrow { transform: translateX(4px); }

/* ═══════════════════════════════════
   S3 — RESOURCES
═══════════════════════════════════ */
.s-resources {
  padding: var(--nav-h) 5rem 2rem;
  display: flex; flex-direction: column;
}
.orb-g1 { width:500px; height:500px; background:var(--green); top:-100px; right:-120px; animation: od 16s ease-in-out infinite; }
.s-resources .sec-label span:last-child { color: var(--green); }
.s-resources .sec-bar { background: var(--green); }
.s-resources .sec-header { margin-bottom: 1.2rem; position: relative; z-index: 1; }

.res-body { flex: 1; min-height: 0; position: relative; z-index: 1; }
.res-scroll {
  height: 100%; overflow-y: auto; padding-right: 0.5rem;
  scrollbar-width: thin; scrollbar-color: var(--border) transparent;
}
.res-scroll::-webkit-scrollbar { width: 4px; }
.res-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

.courses-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 0.6rem; padding-bottom: 1rem; }

.ccard {
  background: var(--surf); border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden; transition: border-color 0.3s;
}
.ccard:hover { border-color: color-mix(in srgb, var(--green) 45%, transparent); }
.ccard-head {
  display: flex; align-items: center; gap: 0.6rem;
  padding: 0.65rem 1rem; width: 100%; text-align: left;
  cursor: pointer; transition: background 0.2s;
}
.ccard-head:hover { background: var(--hover-bg); }
.ccard-name { flex: 1; font-size: 0.88rem; font-weight: 600; color: var(--text); }
.ccard-en { font-size: 0.72rem; color: var(--subtle); font-weight: 400; font-style: normal; margin-left: 0.4rem; }
.ccard-count { font-family: var(--mono); font-size: 0.68rem; color: var(--subtle); background: var(--surf2); padding: 0.1rem 0.45rem; border-radius: 100px; }
.ccard-arrow { color: var(--subtle); font-size: 0.75rem; transition: transform 0.3s; }
.ccard.open .ccard-arrow { transform: rotate(180deg); }
.ccard-body { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.4,0,0.2,1); }
.ccard.open .ccard-body { max-height: 600px; }
.ccard-items { border-top: 1px solid var(--border); padding: 0.3rem 0; }
.citem {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.4rem 1rem; gap: 0.5rem; transition: background 0.2s;
}
.citem:hover { background: var(--hover-bg); }
.citem-title { font-size: 0.8rem; color: var(--muted); flex: 1; }
.citem-links { display: flex; gap: 0.35rem; flex-shrink: 0; }
.clink { font-size: 0.67rem; padding: 0.15rem 0.45rem; border-radius: 4px; font-family: var(--mono); font-weight: 700; transition: all 0.2s; }
.clink.pdf { color: var(--coral); background: color-mix(in srgb, var(--coral) 10%, transparent); border: 1px solid color-mix(in srgb, var(--coral) 22%, transparent); }
.clink.pdf:hover { background: color-mix(in srgb, var(--coral) 22%, transparent); }
.clink.xmind { color: var(--accent2); background: color-mix(in srgb, var(--accent2) 10%, transparent); border: 1px solid color-mix(in srgb, var(--accent2) 22%, transparent); }
.clink.xmind:hover { background: color-mix(in srgb, var(--accent2) 22%, transparent); }

/* ═══════════════════════════════════
   S4 — CONTACT
═══════════════════════════════════ */
.s-contact {
  display: flex; align-items: center; justify-content: center;
  padding: var(--nav-h) 5rem 2rem;
}
.orb-p1 { width:500px; height:500px; background:var(--coral); top:-120px; right:-80px; animation: od 13s ease-in-out infinite; }
.orb-p2 { width:300px; height:300px; background:var(--accent); bottom:-80px; left:-60px; animation: od 9s ease-in-out infinite 2s; }

.contact-layout {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 5rem; max-width: 1000px; width: 100%; position: relative; z-index: 1;
}
.contact-left { display: flex; flex-direction: column; justify-content: center; gap: 1rem; }
.s-contact .sec-label span:last-child { color: var(--coral); }
.s-contact .sec-bar { background: var(--coral); }
.contact-head { font-family: var(--serif); font-size: clamp(3.5rem,7vw,5.5rem); line-height: 1.05; font-weight: 700; }
.ch-accent { color: var(--accent); font-style: italic; }
.contact-sub { color: var(--muted); font-size: 0.95rem; }
.contact-bar { width: 48px; height: 3px; background: linear-gradient(90deg, var(--accent), var(--coral)); border-radius: 2px; }

.contact-right { display: flex; flex-direction: column; justify-content: center; gap: 1.75rem; }
.block-label { font-family: var(--mono); font-size: 0.72rem; color: var(--subtle); letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 0.75rem; }
.email-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.7rem 1rem; background: var(--surf); border: 1px solid var(--border);
  border-radius: 10px; margin-bottom: 0.5rem; transition: all 0.3s;
}
.email-row:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); background: color-mix(in srgb, var(--accent) 4%, transparent); }
.email-info { display: flex; align-items: center; gap: 0.75rem; }
.email-addr { font-family: var(--mono); font-size: 0.82rem; color: var(--text); }
.email-tag { font-size: 0.65rem; color: var(--subtle); background: var(--surf2); padding: 0.12rem 0.4rem; border-radius: 4px; }
.copy-btn {
  font-size: 0.72rem; color: var(--subtle); transition: color 0.3s, border-color 0.3s;
  padding: 0.25rem 0.6rem; border: 1px solid var(--border); border-radius: 5px;
  background: transparent; font-family: var(--mono);
}
.copy-btn:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }

.social-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
.slink {
  display: flex; align-items: center; gap: 0.45rem;
  padding: 0.55rem 0.9rem; background: var(--surf);
  border: 1px solid var(--border); border-radius: 8px;
  color: var(--muted); font-size: 0.82rem; transition: all 0.3s;
}
.slink:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 50%, transparent); background: color-mix(in srgb, var(--accent) 6%, transparent); transform: translateY(-2px); }
.sicon { width: 14px; height: 14px; flex-shrink: 0; }

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
/* ═══════════════════════════════════
   TABLET  (≤ 900px)
═══════════════════════════════════ */
@media (max-width: 900px) {
  .dot-nav { display: none; }
  .about-layout { padding: 0 2.5rem; gap: 2rem; }
  .about-left { top: 0; max-width: 100%; }
  .about-right { margin-right: 0; }
  .avatar-scene { max-width: 300px; }
  .s-research, .s-resources, .s-contact { padding-left: 2rem; padding-right: 2rem; }
  .research-grid { grid-template-columns: 1fr; }
  .contact-layout { grid-template-columns: 1fr; gap: 2rem; }
  .courses-grid { grid-template-columns: 1fr; }
  .email-addr { font-size: 0.7rem; }
}

/* ═══════════════════════════════════
   MOBILE  (≤ 600px)
   Long single-column scroll page.
   Scroll-snap is fully disabled.
   Body is the scroll container.
   Active nav link indicates section.
═══════════════════════════════════ */
@media (max-width: 600px) {

  /* ── Turn body into the scroller ── */
  html { height: auto !important; overflow: visible !important; }
  body { height: auto !important; overflow-x: hidden !important; overflow-y: auto !important; }
  #scroll-container {
    height: auto !important; overflow: visible !important;
    scroll-snap-type: none !important;
  }
  .section {
    height: auto !important; min-height: unset !important;
    scroll-snap-align: none !important; overflow: visible !important;
    padding-bottom: 3.5rem;
  }

  /* ── Navbar: compact so all 4 links + toggle fit ── */
  .nav-inner { padding: 0 0.9rem; }
  .nav-logo { font-size: 1rem; }
  .nav-links { gap: 0.6rem; }
  .nav-link { font-size: 0.65rem; letter-spacing: 0.03em; }
  .theme-toggle { padding: 0.15rem 0.35rem; gap: 0.25rem; }
  .tt-track { width: 20px; height: 12px; border-radius: 6px; }
  .tt-knob { width: 8px; height: 8px; }
  html[data-theme="light"] .tt-knob { transform: translateX(8px); }

  /* ── About: avatar first, text below ── */
  .s-about { padding-top: var(--nav-h); }
  .about-layout {
    flex-direction: column; align-items: center;
    height: auto !important;
    padding: 2rem 1.3rem 0;
    gap: 1.4rem;
  }
  .about-right {
    order: 1; width: 100%; margin-right: 0;
    display: flex; justify-content: center;
  }
  .avatar-scene { max-width: 190px; }
  .chiikawa, .side-dots { display: none; }
  .about-left {
    order: 2; top: 0 !important; max-width: 100%; width: 100%; gap: 0.85rem;
  }
  .greeting { display: none; }
  .hero-name { font-size: clamp(1.9rem, 8.5vw, 2.4rem); }
  .hero-role { font-size: 0.8rem; flex-wrap: nowrap; }
  .role-pre { white-space: nowrap; }
  .hero-bio { font-size: 0.87rem; line-height: 1.75; }
  .hero-tags { gap: 0.4rem; }
  .tag { font-size: 0.7rem; padding: 0.2rem 0.6rem; }
  .hero-cta { flex-wrap: wrap; gap: 0.5rem; }
  .btn { padding: 0.55rem 1rem; font-size: 0.79rem; }
  .scroll-hint { display: none; }

  /* ── Research ── */
  .s-research {
    padding-top: calc(var(--nav-h) + 1.5rem);
    padding-left: 1.3rem; padding-right: 1.3rem;
    justify-content: flex-start;
  }
  .research-grid { grid-template-columns: 1fr; gap: 1rem; max-height: none !important; }
  .s-research .sec-header { margin-bottom: 1rem; }

  /* ── Resources ── */
  .s-resources { padding-top: calc(var(--nav-h) + 1.5rem); padding-left: 1.3rem; padding-right: 1.3rem; }
  .res-scroll { overflow-y: visible !important; max-height: none !important; }
  .courses-grid { grid-template-columns: 1fr; gap: 0.7rem; }

  /* ── Contact ── */
  .s-contact { padding-top: calc(var(--nav-h) + 1.5rem); padding-left: 1.3rem; padding-right: 1.3rem; }
  .contact-layout { grid-template-columns: 1fr; gap: 1.5rem; }
  .email-addr { font-size: 0.67rem; }

  /* ── Shared ── */
  .dot-nav { display: none; }
  .sec-title { font-size: clamp(1.75rem, 7.5vw, 2.2rem); }
  .sec-sub { white-space: normal !important; font-size: 0.84rem; }
  .bg-num, .orb, #particles-canvas { display: none; }
}

/* ═══════════════════════════════════
   CUSTOM CURSOR
═══════════════════════════════════ */
.cur-dot {
  position: fixed; width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent); pointer-events: none; z-index: 9999;
  transform: translate(-50%, -50%);
  transition: background 0.3s, transform 0.12s;
}
.cur-ring {
  position: fixed; width: 30px; height: 30px; border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent);
  pointer-events: none; z-index: 9998;
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s, border-color 0.35s;
}
body.cursor-hover .cur-dot { transform: translate(-50%, -50%) scale(1.8); background: var(--accent2); }
body.cursor-hover .cur-ring { width: 46px; height: 46px; border-color: color-mix(in srgb, var(--accent2) 55%, transparent); }
@media (hover: none) { .cur-dot, .cur-ring { display: none; } }

/* name shimmer on hover */
.hero-name:hover .name-line {
  background: linear-gradient(90deg, var(--text), var(--accent), var(--accent2), var(--text));
  background-size: 200% auto;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 1.8s linear infinite;
}
@keyframes shimmer { to { background-position: 200% center; } }
</style>

<script is:inline>
(function() {

/* ── Particles ── */
const canvas = document.getElementById('particles-canvas');
const ctx = canvas.getContext('2d');
let pts = [];

function resize() {
  const sec = document.getElementById('about');
  canvas.width = sec.offsetWidth;
  canvas.height = sec.offsetHeight;
}

function makePt() {
  const hues = [260, 190, 320];
  const op = Math.random() * 0.35 + 0.1;
  const h = hues[Math.floor(Math.random() * 3)];
  return {
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    vx: (Math.random() - 0.5) * 0.38,
    vy: (Math.random() - 0.5) * 0.38,
    r: Math.random() * 1.4 + 0.4,
    color: `hsla(${h},80%,72%,${op})`
  };
}

function init() { resize(); pts = Array.from({length: 75}, makePt); }

function loop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  for (let i = 0; i < pts.length; i++) {
    const p = pts[i];
    p.x += p.vx; p.y += p.vy;
    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.fillStyle = p.color; ctx.fill();
    for (let j = i + 1; j < pts.length; j++) {
      const q = pts[j];
      const dx = p.x - q.x, dy = p.y - q.y;
      const d = Math.sqrt(dx*dx + dy*dy);
      if (d < 110) {
        ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
        ctx.strokeStyle = `rgba(139,92,246,${0.06*(1-d/110)})`;
        ctx.lineWidth = 0.5; ctx.stroke();
      }
    }
  }
  requestAnimationFrame(loop);
}
init(); loop();
window.addEventListener('resize', init);

/* ── Typewriter ── */
const tw = document.getElementById('typewriter');
const roles = ['Biostatistics', 'Causal Inference', 'AI for Public Health', 'Statistics'];
let ri = 0, ci = 0, del = false;
function type() {
  const cur = roles[ri];
  if (del) {
    ci--; tw.textContent = cur.slice(0, ci);
    if (ci === 0) { del = false; ri = (ri+1) % roles.length; setTimeout(type, 380); return; }
    setTimeout(type, 48);
  } else {
    ci++; tw.textContent = cur.slice(0, ci);
    if (ci === cur.length) { del = true; setTimeout(type, 2400); return; }
    setTimeout(type, 88);
  }
}
setTimeout(type, 900);

/* ── Section tracking ── */
const secs = document.querySelectorAll('.section');
const nlinks = document.querySelectorAll('.nav-link');
const dots = document.querySelectorAll('.dot');

function setActive(id) {
  nlinks.forEach(l => l.classList.toggle('active', l.dataset.target === id));
  dots.forEach(d => d.classList.toggle('active', d.dataset.section === id));
}

const so = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting && e.intersectionRatio >= 0.4) setActive(e.target.id); });
}, { threshold: 0.4, root: null });
secs.forEach(s => so.observe(s));

dots.forEach(d => {
  d.addEventListener('click', () => document.getElementById(d.dataset.section).scrollIntoView({ behavior: 'smooth' }));
});
nlinks.forEach(l => {
  l.addEventListener('click', e => {
    const t = document.getElementById(l.dataset.target);
    if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
  });
});

/* ── Reveal on scroll ── */
const ro = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const items = e.target.querySelectorAll('.r-item,.rr,.rv,.cv');
      items.forEach((el, i) => setTimeout(() => el.classList.add('on'), i * 80));
      ro.unobserve(e.target);
    }
  });
}, { threshold: 0.12, root: null });
secs.forEach(s => ro.observe(s));

setTimeout(() => {
  document.querySelectorAll('#about .r-item').forEach((el, i) => {
    setTimeout(() => el.classList.add('on'), 80 + i * 100);
  });
}, 120);

/* ── 3D card tilt ── */
document.querySelectorAll('.tilt').forEach(card => {
  card.addEventListener('mousemove', e => {
    const r = card.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    card.style.transform = `perspective(700px) rotateX(${y * -7}deg) rotateY(${x * 7}deg) scale(1.025)`;
    card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
    card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'perspective(700px) rotateX(0) rotateY(0) scale(1)';
  });
});

/* ── Course accordion ── */
document.querySelectorAll('.ccard-head').forEach(btn => {
  btn.addEventListener('click', () => {
    const card = btn.closest('.ccard');
    const open = card.classList.contains('open');
    document.querySelectorAll('.ccard.open').forEach(c => c.classList.remove('open'));
    if (!open) card.classList.add('open');
  });
});

/* ── Copy email ── */
document.querySelectorAll('.copy-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    navigator.clipboard.writeText(btn.dataset.email).then(() => {
      const orig = btn.textContent;
      btn.textContent = '✓ Copied';
      btn.style.color = 'var(--green)';
      setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 2000);
    });
  });
});

/* ── Custom cursor ── */
const curDot  = document.getElementById('cur-dot');
const curRing = document.getElementById('cur-ring');
let mx = 0, my = 0, rx = 0, ry = 0;
document.addEventListener('mousemove', e => {
  mx = e.clientX; my = e.clientY;
  curDot.style.left = mx + 'px'; curDot.style.top = my + 'px';
});
(function trackRing() {
  rx += (mx - rx) * 0.1; ry += (my - ry) * 0.1;
  curRing.style.left = rx + 'px'; curRing.style.top = ry + 'px';
  requestAnimationFrame(trackRing);
})();
document.querySelectorAll('a, button').forEach(el => {
  el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
  el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
});

/* ── Magnetic buttons ── */
document.querySelectorAll('.btn-p, .btn-o').forEach(btn => {
  btn.addEventListener('mousemove', e => {
    const r = btn.getBoundingClientRect();
    const x = (e.clientX - r.left - r.width  / 2) * 0.28;
    const y = (e.clientY - r.top  - r.height / 2) * 0.38;
    btn.style.transform = `translate(${x}px, ${y}px)`;
  });
  btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
});

/* ── Orb parallax ── */
const aboutSec = document.getElementById('about');
const o1 = aboutSec.querySelector('.orb-1');
const o2 = aboutSec.querySelector('.orb-2');
aboutSec.addEventListener('mousemove', e => {
  const { left, top, width, height } = aboutSec.getBoundingClientRect();
  const px = (e.clientX - left) / width - 0.5;
  const py = (e.clientY - top) / height - 0.5;
  o1.style.transform = `translate(${px * 35}px, ${py * 35}px) scale(1)`;
  o2.style.transform = `translate(${px * -22}px, ${py * -22}px) scale(1)`;
});
aboutSec.addEventListener('mouseleave', () => {
  o1.style.transform = ''; o2.style.transform = '';
});

/* ── Blob avatar tilt + click ── */
const avatarScene = document.getElementById('avatarScene');
const avatarRing  = document.getElementById('avatarRing');
const blobBorder  = document.getElementById('blobBorder');
const blobGlow    = document.getElementById('blobGlow');
if (avatarScene) {
  avatarScene.addEventListener('mousemove', e => {
    const r = avatarScene.getBoundingClientRect();
    const mx = (e.clientX - r.left) / r.width;
    const my = (e.clientY - r.top)  / r.height;
    avatarRing.style.transform = `perspective(600px) rotateY(${(mx-.5)*10}deg) rotateX(${-(my-.5)*10}deg)`;
  });
  avatarScene.addEventListener('mouseleave', () => { avatarRing.style.transform = ''; });
  avatarScene.addEventListener('click', () => {
    [blobBorder, blobGlow].forEach(el => {
      if (!el) return;
      el.classList.remove('is-clicked');
      void el.offsetWidth;
      el.classList.add('is-clicked');
      setTimeout(() => el.classList.remove('is-clicked'), 800);
    });
  });
}

/* ── Theme toggle ── */
const themeBtn = document.getElementById('themeToggle');
function setTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  localStorage.setItem('theme', t);
}
themeBtn.addEventListener('click', () => {
  document.body.classList.add('t-switching');
  setTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  setTimeout(() => document.body.classList.remove('t-switching'), 500);
});
const savedTheme = localStorage.getItem('theme');
if (savedTheme) {
  setTheme(savedTheme);
} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
  setTheme('dark');
} else {
  setTheme('light');
}
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
  if (!localStorage.getItem('theme')) setTheme(e.matches ? 'dark' : 'light');
});

})();
</script>

</body>
</html>
